<?xml version="1.0" encoding="UTF-8"?>
<robot name="rbkairos_plus">
  <group name="arm">
    <chain base_link="arm_base_link" tip_link="arm_tool0"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="arm_elbow_joint" value="2.4125"/>
    <joint name="arm_shoulder_lift_joint" value="-2.4125"/>
    <joint name="arm_shoulder_pan_joint" value="0"/>
    <joint name="arm_wrist_1_joint" value="-1.57"/>
    <joint name="arm_wrist_2_joint" value="-1.57"/>
    <joint name="arm_wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="test" group="arm">
    <joint name="arm_elbow_joint" value="1.57"/>
    <joint name="arm_shoulder_lift_joint" value="-1.57"/>
    <joint name="arm_shoulder_pan_joint" value="0"/>
    <joint name="arm_wrist_1_joint" value="-1.57"/>
    <joint name="arm_wrist_2_joint" value="-1.57"/>
    <joint name="arm_wrist_3_joint" value="0"/>
  </group_state>

  <!-- A virtual joint must connect an external frame to the URDF root. -->
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="robot_base_footprint"/>

  <passive_joint name="robot_back_left_wheel_joint"/>
  <passive_joint name="robot_back_right_wheel_joint"/>
  <passive_joint name="robot_front_left_wheel_joint"/>
  <passive_joint name="robot_front_right_wheel_joint"/>

  <disable_collisions link1="arm_base_link_inertia" link2="arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link_inertia" link2="arm_upper_arm_link" reason="Never"/>
  <disable_collisions link1="arm_base_link_inertia" link2="arm_wrist_1_link" reason="Never"/>
  <disable_collisions link1="arm_base_link_inertia" link2="robot_back_left_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_base_link_inertia" link2="robot_back_right_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_base_link_inertia" link2="robot_base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link_inertia" link2="robot_front_left_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_base_link_inertia" link2="robot_front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_forearm_link" link2="arm_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_forearm_link" link2="arm_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="arm_shoulder_link" link2="arm_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_shoulder_link" link2="arm_wrist_1_link" reason="Never"/>
  <disable_collisions link1="arm_shoulder_link" link2="robot_back_left_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_shoulder_link" link2="robot_back_right_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_shoulder_link" link2="robot_base_link" reason="Never"/>
  <disable_collisions link1="arm_shoulder_link" link2="robot_front_left_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_shoulder_link" link2="robot_front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_wrist_1_link" link2="arm_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_1_link" link2="arm_wrist_3_link" reason="Never"/>
  <disable_collisions link1="arm_wrist_2_link" link2="arm_wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="robot_back_left_wheel_link" link2="robot_back_right_wheel_link" reason="Never"/>
  <disable_collisions link1="robot_back_left_wheel_link" link2="robot_base_link" reason="Adjacent"/>
  <disable_collisions link1="robot_back_left_wheel_link" link2="robot_front_left_wheel_link" reason="Never"/>
  <disable_collisions link1="robot_back_left_wheel_link" link2="robot_front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="robot_back_right_wheel_link" link2="robot_base_link" reason="Adjacent"/>
  <disable_collisions link1="robot_back_right_wheel_link" link2="robot_front_left_wheel_link" reason="Never"/>
  <disable_collisions link1="robot_back_right_wheel_link" link2="robot_front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="robot_base_link" link2="robot_front_left_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="robot_base_link" link2="robot_front_right_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="robot_front_left_wheel_link" link2="robot_front_right_wheel_link" reason="Never"/>
</robot>
