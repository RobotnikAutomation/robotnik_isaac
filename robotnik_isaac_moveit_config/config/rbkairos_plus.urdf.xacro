<?xml version="1.0"?>
<robot name="rbkairos_plus" xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    MoveIt's planning model mirrors the sensor-free Isaac composition: one
    RB-KAIROS base plus one UR10e. The base uses robot_ and the arm uses arm_,
    matching the imported Isaac articulation. robot_id is only a ROS namespace.
  -->
  <xacro:arg name="ur_type" default="ur10e"/>
  <xacro:arg name="gazebo_ignition" default="false"/>

  <xacro:include filename="$(find robotnik_description)/urdf/bases/rbkairos/rbkairos_base.urdf.xacro"/>
  <xacro:include filename="$(find robotnik_description)/urdf/arms/ur_macro.urdf.xacro"/>

  <xacro:rbkairos prefix="robot_" gazebo_ignition="$(arg gazebo_ignition)" namespace="robot"/>
  <xacro:arm_ur
    ur_type="$(arg ur_type)"
    frame_prefix="arm_"
    parent="robot_top_cover"
    gazebo_ignition="$(arg gazebo_ignition)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:arm_ur>
</robot>
