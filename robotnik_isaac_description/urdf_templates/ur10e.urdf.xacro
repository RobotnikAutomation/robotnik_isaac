<?xml version="1.0"?>
<robot name="ur10e" xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- A self-contained root is required when importing the arm on its own. -->
  <xacro:arg name="ur_type" default="ur10e"/>
  <xacro:arg name="gazebo_ignition" default="false"/>
  <xacro:include filename="$(find robotnik_description)/urdf/arms/ur_macro.urdf.xacro"/>
  <link name="arm_mount_link"/>
  <xacro:arm_ur ur_type="ur10e" frame_prefix="arm_" parent="arm_mount_link" gazebo_ignition="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:arm_ur>
</robot>
