<?xml version="1.0"?>
<robot name="rbkairos_plus_isaac_control">
  <!-- Kairos Plus ros2_control integration model. Isaac remains the source of the visual and
       physical robot; this skeleton only declares controller interfaces. -->
  <link name="robot_base_link"/>
  <link name="robot_front_left_wheel_link"/>
  <link name="robot_front_right_wheel_link"/>
  <link name="robot_back_left_wheel_link"/>
  <link name="robot_back_right_wheel_link"/>
  <link name="arm_base_link"/>
  <link name="arm_shoulder_link"/>
  <link name="arm_upper_arm_link"/>
  <link name="arm_forearm_link"/>
  <link name="arm_wrist_1_link"/>
  <link name="arm_wrist_2_link"/>
  <link name="arm_wrist_3_link"/>

  <joint name="robot_front_left_wheel_joint" type="continuous"><parent link="robot_base_link"/><child link="robot_front_left_wheel_link"/><axis xyz="0 1 0"/></joint>
  <joint name="robot_front_right_wheel_joint" type="continuous"><parent link="robot_base_link"/><child link="robot_front_right_wheel_link"/><axis xyz="0 1 0"/></joint>
  <joint name="robot_back_left_wheel_joint" type="continuous"><parent link="robot_base_link"/><child link="robot_back_left_wheel_link"/><axis xyz="0 1 0"/></joint>
  <joint name="robot_back_right_wheel_joint" type="continuous"><parent link="robot_base_link"/><child link="robot_back_right_wheel_link"/><axis xyz="0 1 0"/></joint>
  <joint name="arm_mount_joint" type="fixed"><parent link="robot_base_link"/><child link="arm_base_link"/></joint>
  <joint name="arm_shoulder_pan_joint" type="continuous"><parent link="arm_base_link"/><child link="arm_shoulder_link"/></joint>
  <joint name="arm_shoulder_lift_joint" type="continuous"><parent link="arm_shoulder_link"/><child link="arm_upper_arm_link"/></joint>
  <joint name="arm_elbow_joint" type="revolute"><parent link="arm_upper_arm_link"/><child link="arm_forearm_link"/><limit lower="-3.14159265359" upper="3.14159265359" effort="150" velocity="3.14159265359"/></joint>
  <joint name="arm_wrist_1_joint" type="continuous"><parent link="arm_forearm_link"/><child link="arm_wrist_1_link"/></joint>
  <joint name="arm_wrist_2_joint" type="continuous"><parent link="arm_wrist_1_link"/><child link="arm_wrist_2_link"/></joint>
  <joint name="arm_wrist_3_joint" type="continuous"><parent link="arm_wrist_2_link"/><child link="arm_wrist_3_link"/></joint>

  <ros2_control name="IsaacSystem" type="system">
    <hardware>
      <plugin>robotnik_isaac_ros2_control/IsaacSystem</plugin>
      <param name="state_topic">isaac/joint_states</param>
      <param name="command_topic">isaac/joint_command</param>
      <param name="qos_depth">5</param>
      <param name="state_qos_reliability">best_effort</param>
      <param name="command_qos_reliability">reliable</param>
      <param name="state_timeout">0.0</param>
      <param name="require_all_joints">false</param>
      <param name="reject_nonfinite_state">true</param>
      <param name="enforce_command_limits">true</param>
    </hardware>

    <joint name="robot_front_left_wheel_joint"><command_interface name="velocity"><param name="min">-10.0</param><param name="max">10.0</param><param name="initial_value">0.0</param></command_interface><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
    <joint name="robot_front_right_wheel_joint"><command_interface name="velocity"><param name="min">-10.0</param><param name="max">10.0</param><param name="initial_value">0.0</param></command_interface><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
    <joint name="robot_back_left_wheel_joint"><command_interface name="velocity"><param name="min">-20.0</param><param name="max">20.0</param><param name="initial_value">0.0</param></command_interface><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
    <joint name="robot_back_right_wheel_joint"><command_interface name="velocity"><param name="min">-20.0</param><param name="max">20.0</param><param name="initial_value">0.0</param></command_interface><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>

    <joint name="arm_shoulder_pan_joint"><command_interface name="position"><param name="initial_value">0.0</param></command_interface><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
    <joint name="arm_shoulder_lift_joint"><command_interface name="position"><param name="initial_value">-2.4125</param></command_interface><state_interface name="position"><param name="initial_value">-2.4125</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
    <joint name="arm_elbow_joint"><command_interface name="position"><param name="initial_value">2.4125</param></command_interface><state_interface name="position"><param name="initial_value">2.4125</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
    <joint name="arm_wrist_1_joint"><command_interface name="position"><param name="initial_value">-1.57</param></command_interface><state_interface name="position"><param name="initial_value">-1.57</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
    <joint name="arm_wrist_2_joint"><command_interface name="position"><param name="initial_value">-1.57</param></command_interface><state_interface name="position"><param name="initial_value">-1.57</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
    <joint name="arm_wrist_3_joint"><command_interface name="position"><param name="initial_value">0.0</param></command_interface><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface><state_interface name="effort"><param name="initial_value">0.0</param></state_interface></joint>
  </ros2_control>
</robot>
