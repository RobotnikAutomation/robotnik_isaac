#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "rbkairos_plus"
    doc = """Generated from Composed Stage of root layer /tmp/tmpoxfkn6wc/rbkairos_plus.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_rbkairos_plus_pdc36xf_/usdex_rbkairos_plus/rbkairos_plus.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_rbkairos_plus_pdc36xf_/temp_rbkairos_plus/rbkairos_plus.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "rbkairos_plus" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </rbkairos_plus/Physics/root_joint>,
        </rbkairos_plus/Physics/robot_base_footprint_joint>,
        </rbkairos_plus/Physics/robot_top_cover_joint>,
        </rbkairos_plus/Physics/robot_base_logo_left_joint>,
        </rbkairos_plus/Physics/robot_base_logo_right_joint>,
        </rbkairos_plus/Physics/robot_base_logo_front_joint>,
        </rbkairos_plus/Physics/robot_base_logo_rear_joint>,
        </rbkairos_plus/Physics/robot_front_right_wheel_joint>,
        </rbkairos_plus/Physics/robot_front_left_wheel_joint>,
        </rbkairos_plus/Physics/robot_back_left_wheel_joint>,
        </rbkairos_plus/Physics/robot_back_right_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </rbkairos_plus/Geometry/robot_base_footprint>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_top_cover>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_base_logo_left>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_base_logo_right>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_base_logo_front>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_base_logo_rear>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_front_right_wheel_link>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_front_left_wheel_link>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_back_left_wheel_link>,
        </rbkairos_plus/Geometry/robot_base_footprint/robot_base_link/robot_back_right_wheel_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "robot_base_footprint" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "robot_base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "robot_top_cover" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_base_logo_left" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_base_logo_right" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_base_logo_front" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_base_logo_rear" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_front_right_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_front_left_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_back_left_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_back_right_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "robot_base_docking_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_base_footprint_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_top_cover_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_base_logo_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_base_logo_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_base_logo_front_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_base_logo_rear_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_front_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_front_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_back_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "robot_back_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

