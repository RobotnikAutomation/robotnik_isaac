#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "World" {
    def Cube "navigation_obstacle_1" {
        double size = 1
        double3 xformOp:translate = (2, 1, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "navigation_obstacle_2" {
        double size = 1
        double3 xformOp:translate = (-2, -1, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
